generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportSource {
  WEB
  LINE
}

model Report {
  id              String       @id @default(cuid())
  location        String
  newCount        Float
  semiCount       Float
  reportedAt      DateTime     @default(now())
  source          ReportSource @default(WEB)
  lineMessageId   String?      @unique
  lineGroupId     String?
  lineUserId      String?
  originalMessage String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([location, reportedAt(sort: Desc)])
  @@index([reportedAt(sort: Desc)])
}

model WebhookReceipt {
  webhookEventId String   @id
  processedAt    DateTime @default(now())
}

model Purchase {
  id              String               @id @default(cuid())
  boxCount        Int
  tubesPerBox     Int
  purchasedAt     DateTime             @default(now())
  lineMessageId   String               @unique
  lineGroupId     String
  lineUserId      String?
  originalMessage String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  allocations     PurchaseAllocation[]

  @@index([purchasedAt(sort: Desc)])
}

model PurchaseAllocation {
  id         String   @id @default(cuid())
  purchaseId String
  location   String
  tubeCount  Int
  createdAt  DateTime @default(now())
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, location])
  @@index([location])
}

model ShuttleTransfer {
  id              String   @id @default(cuid())
  fromLocation    String
  toLocation      String
  tubeCount       Float
  semiTubeCount   Float    @default(0)
  transferredAt   DateTime @default(now())
  lineMessageId   String   @unique
  lineGroupId     String
  lineUserId      String?
  originalMessage String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transferredAt(sort: Desc)])
}
