# Pooled connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Direct connection used by Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# LINE Messaging API credentials and deployment settings.
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# Set to "discover" only while obtaining a group ID, then replace immediately.
LINE_ALLOWED_GROUP_ID=""
APP_BASE_URL=""
